# ---------------------------------------------------------------------------
# InstruChat — environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Public — Formspree endpoint for the "Solicitar instrumento" form.
# Create a free form at https://formspree.io, then paste its endpoint here.
# Without this, the request page shows a setup notice instead of a form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT="https://formspree.io/f/your-form-id"
